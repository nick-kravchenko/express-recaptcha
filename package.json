{
  "name": "express-recaptcha",
  "version": "5.0.2",
  "description": "Google recaptcha middleware for express",
  "main": "./dist/index.js",
  "types": "./dist/index.d.js",
  "scripts": {
    "test:watch": "mocha --watch",
    "test": "tsc -p test --noEmit && mocha",
    "clean": "rm -rf ./dist",
    "build": "tsc --project src",
    "build:dev": "npm run clean && npm run build",
    "build:prod": "npm run test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pdupavillon/express-recaptcha.git"
  },
  "keywords": [
    "express",
    "javascript",
    "nodejs",
    "recaptcha",
    "google",
    "captcha",
    "jade"
  ],
  "author": "Paul du Pavillon",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/pdupavillon/express-recaptcha/issues"
  },
  "homepage": "https://github.com/pdupavillon/express-recaptcha",
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/express": "^5.0.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "@types/sinon": "^22.0.1",
    "body-parser": "^2.4.0",
    "chai": "^6.3.0",
    "express": "^5.3.0",
    "mocha": "^12.0.3",
    "pug": "^3.0.4",
    "sinon": "^22.1.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">= 6"
  }
}
